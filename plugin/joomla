#!/usr/bin/env bash

# Some hosting layouts keep the site in a `public_html` directory or symlink.
backup_root=''

if [[ -d 'public_html' && -f 'public_html/configuration.php' ]]; then
    backup_root="$(readlink -f 'public_html')"
    cd "${backup_root}"
fi

grep 'JConfig' 'configuration.php' &>/dev/null || exit 1

if [[ -n "${backup_root}" ]]; then
    echo "backup_root: ${backup_root}"
fi

cat <<CONFIG
exclude: /cache/* /tmp/* /administrator/cache/*
include: */index.html
CONFIG

sed -nE \
    -e "s/^.*\\\$dbtype[=[:space:]]+.*'(mysqli|mysql|pdomysql)'.*$/database_type: mysql/p" \
    -e "s/^.*\\\$dbtype[=[:space:]]+.*'(pgsql|postgresql)'.*$/database_type: postgresql/p" \
    -e "s/^.*\\\$db[=[:space:]]+.*'(.*)'.*$/database_name: \1/p" \
    -e "s/^.*\\\$user[=[:space:]]+.*'(.*)'.*$/database_user: \1/p" \
    -e "s/^.*\\\$password[=[:space:]]+.*'(.*)'.*$/database_password: \1/p" \
    'configuration.php'
