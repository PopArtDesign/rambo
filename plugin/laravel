#!/usr/bin/env bash

[[ -f 'artisan' ]] || exit 1

cat <<CONFIG
exclude: /storage/framework/cache/* /bootstrap/cache/*
CONFIG

[[ -r '.env' ]] || exit 0

while read -r env_key config_key; do
    sed -nE \
        -e "s/^[[:space:]]*(export[[:space:]]+)?${env_key}[[:space:]]*=[[:space:]]*([\"'])(.+)\\2[[:space:]]*(#.*)?$/database_${config_key}: \\3/p" \
        -e "s/^[[:space:]]*(export[[:space:]]+)?${env_key}[[:space:]]*=[[:space:]]*([^'\"#]*[^'\"#[:space:]])[[:space:]]*(#.*)?$/database_${config_key}: \\2/p" \
        '.env'
done <<'KEYS' | sed -E 's/^database_type: (pgsql|postgres)$/database_type: postgresql/'
DB_CONNECTION type
DB_HOST host
DB_PORT port
DB_DATABASE name
DB_USERNAME user
DB_PASSWORD password
KEYS
