#!/usr/bin/env bash

# Some hosting layouts keep the site in a `public_html` directory or symlink.
backup_root=''

if [[ -d 'public_html' && -f 'public_html/wp-config.php' ]]; then
    backup_root="$(readlink -f 'public_html')"
    cd "${backup_root}"
fi

[[ -f 'wp-config.php' ]] || exit 1

if [[ -n "${backup_root}" ]]; then
    echo "backup_root: ${backup_root}"
fi

cat <<CONFIG
exclude: /wp-content/cache/*
database_type: mysql
CONFIG

sed -nE \
    -e "s/^.*DB_NAME.*'(.*)'.*$/database_name: \1/p" \
    -e "s/^.*DB_USER.*'(.*)'.*$/database_user: \1/p" \
    -e "s/^.*DB_PASSWORD.*'(.*)'.*$/database_password: \1/p" \
    'wp-config.php'
