#!/usr/bin/env bash

source "${app_common}"

app::use 'database'
app::use 'error'
app::use 'site'

main() {
    local opt_help=false

    while [[ $# -gt 0 ]]; do
        case "${1}" in
            -h | --help ) opt_help=true ;;
            -- ) shift && break ;;
            -?* ) app::error::unknown_option "${1}" ;;
            * ) break
        esac

        shift
    done

    if [[ "${opt_help}" == 'true' ]]; then
        app_help

        exit 0
    fi

    if [[ $# -gt 1 ]]; then
        app::error::too_many_arguments 1
    fi

    if [[ $# -lt 1 ]]; then
        app::error::missing_argument 'path to site or config file'
    fi

    local site_path="${1}"

    local -A site_config=()

    app::site::load_site_config "${site_path}"

    local db_type="${site_config[database_type]:-}"

    if [[ -z "${db_type}" && -n "${site_config[database_name]:-}" ]]; then
        db_type="$(app::database::detect_type || true)"
    fi

    app_header 'Plugin'

    echo "Name: ${site_config[plugin]##*/}"
    echo "Path: ${site_config[plugin_path]:-~}"

    app_header 'Site'

    local local_config_file="${site_config[local_config_file]:-~}"

    echo "Main config:  ${site_config[main_config_file]:-~}"
    echo "Local config: ${local_config_file##*/}"
    echo
    echo "Root:    ${site_config[root]:-~}"
    echo "Exclude: ${site_config[exclude]:-~}"
    echo "Include: ${site_config[include]:-~}"

    app_header 'Database'

    echo "Name:     ${site_config[database_name]:-~}"
    echo "Type:     ${db_type:-~}"
    echo "Host:     ${site_config[database_host]:-~}"
    echo "Port:     ${site_config[database_port]:-~}"
    echo "User:     ${site_config[database_user]:-~}"

    if [[ -n "${site_config[database_password]:-}" ]]; then
        echo 'Password: ********'
    else
        echo 'Password: ~'
    fi
}

app_header() {
    printf "\n### %s\n\n" "${1}"
}

app_help() {
    local app_command="${0##*/}"

    cat <<HELP
Detect site's configuration

Usage:

  ${app_name} ${app_command} [options] <site path>

Arguments:

  site path  Path to site's root or config file

Options:

  -h, --help  Show this help
HELP
}

main "$@"
