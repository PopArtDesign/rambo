#!/usr/bin/env bash

source "${app_common}"

app::use 'error'
app::use 'site'
app::use 'util'

main() {
    local opt_help=false

    while [[ $# -gt 0 ]]; do
        case "${1}" in
        -h | --help) opt_help=true ;;
        --) shift && break ;;
        -?*) app::error::unknown_option "${1}" ;;
        *) break ;;
        esac

        shift
    done

    if [[ "${opt_help}" == 'true' ]]; then
        app_help

        exit 0
    fi

    if [[ $# -gt 1 ]]; then
        app::error::too_many_arguments 1
    fi

    if [[ $# -lt 1 ]]; then
        app::error::missing_argument 'path to site or config file'
    fi

    local site_path="${1}"

    local -A site_config=()

    app::site::load_site_config "${site_path}"

    app_header 'Plugin'

    echo "Name: ${site_config[plugin]##*/}"
    echo "Path: ${site_config[plugin_path]:-~}"

    app_header 'Site'

    local local_config_file="${site_config[local_config_file]:-~}"

    app::util::print_fields \
        'Main config:' "${site_config[main_config_file]:-~}" \
        'Local config:' "${local_config_file##*/}"

    echo

    local -a site_fields=('Root:' "${site_config[root]:-~}")

    if [[ "${site_config[backup_root]:-}" != "${site_config[root]:-}" ]]; then
        site_fields+=('Backup root:' "${site_config[backup_root]}")
    fi

    site_fields+=(
        'Exclude:' "${site_config[exclude]:-~}"
        'Include:' "${site_config[include]:-~}"
    )

    app::util::print_fields "${site_fields[@]}"

    app_header 'Database'

    local database_password='~'

    if [[ -n "${site_config[database_password]:-}" ]]; then
        database_password='********'
    fi

    app::util::print_fields \
        'Name:' "${site_config[database_name]:-~}" \
        'Type:' "${site_config[database_type]:-~}" \
        'Host:' "${site_config[database_host]:-~}" \
        'Port:' "${site_config[database_port]:-~}" \
        'User:' "${site_config[database_user]:-~}" \
        'Password:' "${database_password}"
}

app_header() {
    printf "\n### %s\n\n" "${1}"
}

app_help() {
    local app_command="${0##*/}"

    cat <<HELP
Detect site's configuration

Usage:

  ${app_name} ${app_command} [options] <site path>

Arguments:

  site path  Path to site's root or config file

Options:

  -h, --help  Show this help
HELP
}

main "$@"
